
"use client";

import { useEffect } from "react";
import { useEditor, EditorContent } from "@tiptap/react";
import StarterKit from "@tiptap/starter-kit";
import Image from "@tiptap/extension-image";
import { InsetText } from "./InsetText";

type StoryEditorProps = {
  value: string;
  onChange: (value: string) => void;
  disabled?: boolean;
};

export default function StoryEditor({
  value,
  onChange,
  disabled = false,
}: StoryEditorProps) {
  const editor = useEditor({
    extensions: [StarterKit, InsetText, Image],
    content: value,
    immediatelyRender: false,
    onUpdate: ({ editor }) => {
      onChange(editor.getHTML());
    },
    editorProps: {
      attributes: {
        class:
          "min-h-96 w-full rounded-lg border p-4 focus:outline-none         [&_h2]:text-2xl [&_h2]:font-bold [&_h3]:text-xl [&_h3]:font-semibold  [&_ul]:list-disc [&_ul]:pl-6 [&_a]:text-blue-600 [&_a]:underline [&_blockquote]:mx-8 [&_blockquote]:px-4 [&_blockquote]:text-center [&_blockquote]:italic ",

      },
    },
  });

  useEffect(() => {
    if (!editor) return;

    if (editor.getHTML() !== value) {
      editor.commands.setContent(value, { emitUpdate: false });
    }
  }, [editor, value]);

  useEffect(() => {
    if (!editor) return;
    editor.setEditable(!disabled);
  }, [editor, disabled]);
  return (
    <div>
      <div className="mb-2 flex gap-2">
        <button
          type="button"
          onClick={() => editor?.chain().focus().toggleHeading({ level: 2 }).run()}
          className="rounded border px-3 py-2"
        >
          Heading 2
        </button>       
        <button
          type="button"
          onClick={() => editor?.chain().focus().toggleHeading({ level: 3 }).run()}
          className="rounded border px-3 py-2"
        >
          Heading 3
        </button>
 <button
          type="button"
          onClick={() => editor?.chain().focus().toggleBold().run()}
          className="rounded border px-3 py-2 font-bold"
        >
          Bold
        </button>
        <button
          type="button"
          onClick={() => editor?.chain().focus().toggleItalic().run()}
          className="rounded border px-3 py-2 italic"
        >
          Italic
        </button>
        <button
          type="button"
          onClick={() => editor?.chain().focus().toggleBulletList().run()}
          className="rounded border px-3 py-2"
        >
          Bullet List
        </button>
<button
          type="button"
          onClick={() => editor?.chain().focus().undo().run()}
          className="rounded border px-3 py-2"
        >
          Undo
        </button>
        <button
          type="button"
          onClick={() => editor?.chain().focus().redo().run()}
          className="rounded border px-3 py-2"
        >
          Redo
        </button>
        <button
          type="button"
          onClick={() => {
            if (!editor) return;
                        const { from, to } = editor.state.selection;
            const url = window.prompt("Enter the website address (URL):");
            if (url) {
              editor.chain().focus().setTextSelection({ from, to }).setLink({ href: url }).run();            
          }}}
          className="rounded border px-3 py-2"
        >
          Link
        </button>
        <button
          type="button"
          onClick={() => editor?.chain().focus().toggleInsetText().run()}
          className="rounded border px-3 py-2"
        >
          Inset Text
        </button>
<button
  type="button"
  onClick={() => editor?.chain().focus().toggleBlockquote().run()}
  className="rounded border px-3 py-2"
>
  Block Quote
</button>
        <button
          type="button"
          onClick={() => editor?.chain().focus().unsetAllMarks().run()}
          className="rounded border px-3 py-2"
        >
          Clear Formatting
        </button>
        <button
          type="button"
          disabled={!editor}
          onClick={async () => {
            if (!editor) return;

            const picker = document.createElement("input");
            picker.type = "file";
            picker.accept = "image/jpeg,image/png";

            picker.onchange = async () => {
              const file = picker.files?.[0];
              if (!file) return;

              const position = editor.state.selection.from;
              const form = new FormData();
              form.append("file", file);

              try {
                const response = await fetch("/api/dashboard/upload", {
                  method: "POST",
                  body: form,
                });
                const result = await response.json();

                if (!response.ok) {
                  throw new Error(result.error || "Upload failed");
                }

                editor.chain().focus()
                  .insertContentAt(position, {
                    type: "image",
                    attrs: { src: result.url, alt: file.name },
                  })
                  .run();
              } catch (error) {
                window.alert(
                  error instanceof Error ? error.message : "Upload failed"
                );
              }
            };

            picker.click();
          }}
          className="rounded border px-3 py-2"
        >
          Insert Photo
        </button>
      </div>
      <EditorContent editor={editor} />
    </div>
  );
}

